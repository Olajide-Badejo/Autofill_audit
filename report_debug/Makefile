# Local build for the debug report of spec section 17.3.
#
# The repository root Makefile's `reports` target builds all three reports and
# is what continuous integration and a reader should use. This file exists
# because the specification asks for it and because a local build is convenient
# while the sections are being edited.
#
# The engine is latexmk over the TeX Live installation resolved at P0 and
# recorded in docs/adr/0001-toolchain-resolution.md.
#
# The tables and the value macros this document shares with the main report are
# generated by scripts/make_report_tables.py from committed result files, so a
# build from a clean checkout runs that script first. Run it from the repository
# root, which is where its default paths are anchored.

LATEXMK ?= latexmk
PYTHON ?= $(HOME)/.venvs/autofill-audit/bin/python
ROOT := $(CURDIR)/..

.PHONY: all tables clean

all: tables
	$(LATEXMK) -pdf -interaction=nonstopmode -halt-on-error debug_report.tex

tables:
	cd $(ROOT) && $(PYTHON) scripts/make_report_tables.py

clean:
	$(LATEXMK) -C debug_report.tex
