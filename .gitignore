# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Environments
.venv/
venv/
env/

# Build artefacts. Anchored to the repository root: an unanchored pattern would
# also match any package directory that happens to share the name.
/build/
/dist/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Scratch space for shell scripts that are not part of the project
.scratch/

# The generated corpus is regenerable from its seed and is not committed. The
# small sample corpus P1 commits for the test suite is exempted here.
#
# The leading slash matters. Without it the pattern also matches
# src/autofill_audit/corpus/, which is source code and must be committed.
/corpus/
!/corpus/sample/
!/corpus/manifest.json

# LaTeX build directories. The compiled PDFs themselves are committed at the tag
# that publishes them (spec section 17.1), so they are not ignored.
report/build/
report_debug/build/
report_for_me/build/
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# models/ is committed, together with its model card (ground rule 8).
# experiments/ is committed: predictions and results are append-only history.
